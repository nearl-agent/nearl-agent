# Copy this file to .env and fill it in. NEVER share .env or commit it.

# Private key of a NEW wallet made only for deploying NEARL.
# Do not use your main wallet. Keep only the ETH needed for gas in it.
DEPLOYER_PRIVATE_KEY=

# Optional: your own RPC URLs. The public Robinhood Chain RPCs work but are rate-limited.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Mainnet only: USDG (Paxos Global Dollar) on Robinhood Chain.
# Check this address at https://docs.paxos.com/guides/stablecoin/usdg/mainnet and https://docs.robinhood.com/chain
MAINNET_STABLECOIN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
MAINNET_STABLECOIN_SYMBOL=USDG
